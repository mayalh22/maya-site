rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'maya.l.hazarika@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Content docs are public to read (they power the live site) and
    // only writable by the signed-in site owner.
    match /{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
